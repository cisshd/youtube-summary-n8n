        "jsCode": "const transcriptArray = $json.transcript || $json.data || [];\n\nconst text = Array.isArray(transcriptArray)\n  ? transcriptArray.map(x => x.text).join(' ')\n  : '';\n\nreturn [{ json: { transcript: text } }];"
