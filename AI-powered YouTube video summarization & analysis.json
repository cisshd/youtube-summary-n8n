    {
      "parameters": {
        "jsCode": "// 1) Read URL from multiple possible locations\nconst payload = items?.[0]?.json ?? {};\n\nconst youtubeUrl =\n  payload.url ??\n  payload.youtubeUrl ??\n  payload.body?.url ??\n  payload.body?.youtubeUrl ??\n  payload.query?.url ??\n  payload.query?.youtubeUrl ??\n  null;\n\n// 2) Validate URL\nif (typeof youtubeUrl !== 'string' || youtubeUrl.trim() === '') {\n  throw new Error(\n    `YouTube URL is missing. I received this JSON: ${JSON.stringify(payload)}`\n  );\n}\n\n// 3) Extract videoId safely\nconst extractYoutubeId = (url) => {\n  if (typeof url !== 'string') return null;\n\n  const pattern =\n    /(?:youtube\\.com\\/(?:[^\\/]+\\/.+\\/|(?:v|e(?:mbed)?)\\/|.*[?&]v=)|youtu\\.be\\/)([^\"&?\\/\\s]{11})/;\n\n  const match = url.match(pattern);\n  return match ? match[1] : null;\n};\n\nconst videoId = extractYoutubeId(youtubeUrl);\n\nif (!videoId) {\n  throw new Error(`Could not extract videoId from URL: ${youtubeUrl}`);\n}\n\nreturn [{ json: { videoId, youtubeUrl } }];"
      },
