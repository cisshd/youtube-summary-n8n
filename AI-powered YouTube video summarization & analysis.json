    {
      "parameters": {
        "jsCode": "const text = ($json.summary ?? \"\").toString();\n\n// Telegram max ~4096 chars. نخليها 3800 عشان مساحة تنسيق\nconst maxLen = 3800;\n\nconst clipped =\n  text.length > maxLen ? text.slice(0, maxLen) + \"\\n\\n(…تكملة في Lovable/Webhook)\" : text;\n\nreturn [{ json: { ...$json, telegramText: clipped } }];"
      },
